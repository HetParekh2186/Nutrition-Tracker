# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres for the app: Transaction pooler, port 6543
DATABASE_URL=
# Postgres for drizzle-kit migrations: Session pooler, port 5432
MIGRATION_DATABASE_URL=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voyage AI embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# USDA FoodData Central (api.data.gov)
FDC_API_KEY=

# Shared secret for the cron route
CRON_SECRET=

# Public demo account (pnpm demo:user creates it)
DEMO_EMAIL=demo@mise.app
DEMO_PASSWORD=
