# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection for Drizzle (Transaction pooler, port 6543)
DATABASE_URL=

# Public base URL, used for magic link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Voyage AI embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# USDA FoodData Central (api.data.gov)
FDC_API_KEY=

# Shared secret for the cron route
CRON_SECRET=
